# Supabase public browser configuration only.
# Never put a Supabase service_role key in Vercel client environment variables.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-or-publishable-key"


# Optional AI key. Do not expose a private AI key in VITE_ variables.
GEMINI_API_KEY=""
