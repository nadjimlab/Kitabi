# Supabase public browser configuration only.
# Never put a Supabase service_role key in Vercel client environment variables.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-or-publishable-key"

# Legacy Firebase variables are no longer required by the production Supabase app.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# Optional AI key. Do not expose a private AI key in VITE_ variables.
GEMINI_API_KEY=""
